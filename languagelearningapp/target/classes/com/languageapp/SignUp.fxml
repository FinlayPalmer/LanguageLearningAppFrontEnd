<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import java.net.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SignUpController" prefWidth="375" prefHeight="667" stylesheets="@styles.css">
   <children>
      <VBox alignment="CENTER" layoutX="50" layoutY="30" prefWidth="275" spacing="15">
          <children>
              <Label text="Sign Up" style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: white;" />
              
              <VBox spacing="5">
                  <Label text="First Name" />
                  <TextField fx:id="firstNameField" promptText="Enter your first name" />
              </VBox>
              
              <VBox spacing="5">
                  <Label text="Last Name" />
                  <TextField fx:id="lastNameField" promptText="Enter your last name" />
              </VBox>
              
              <VBox spacing="5">
                  <Label text="Email" />
                  <TextField fx:id="emailField" promptText="Enter your email" />
              </VBox>
              
              <VBox spacing="5">
                  <Label text="Date of Birth" />
                  <TextField fx:id="dobField" promptText="Enter your date of birth" />
              </VBox>
              
              <VBox spacing="5">
                  <Label text="Username" />
                  <TextField fx:id="usernameField" promptText="Enter your username" />
              </VBox>
              
              <VBox spacing="5">
                  <Label text="Password" />
                  <PasswordField fx:id="passwordField" promptText="Enter your password" />
              </VBox>
              
              <Button text="Submit" onAction="#submitSignUp" style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-weight: bold;" />
              <Button text="Back to Start" onAction="#switchToStart" style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-weight: bold;" />
          </children>
      </VBox>
   </children>
   <stylesheets>
      <URL value="@styles.css" />
    </stylesheets>
</AnchorPane>
