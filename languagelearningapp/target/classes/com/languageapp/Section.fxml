<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SectionController">
   <children>
      <Label styleClass="title" text="Available Sections" />
      <ImageView fitHeight="86.0" fitWidth="95.0" onMouseClicked="#switchToLeaderboard" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/leaderboard.jpg" />
         </image>
      </ImageView>
      <Button fx:id="easy" onAction="#switchToEasy" text="Easy" />
      <Button fx:id="medium" onAction="#switchToMedium" text="Medium" />
      <Button fx:id="difficult" onAction="#switchToDifficult" text="Difficult" />

      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToCurrentLesson" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/lesson.jpg" />
         </image>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToSection" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/home.jpg" />
         </image>
         <VBox.margin>
            <Insets right="200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToProfile" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/profile.jpg" />
         </image>
         <VBox.margin>
            <Insets right="-200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
      
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
