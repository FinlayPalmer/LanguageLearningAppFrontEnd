<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import java.net.*?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SignUpController" alignment="CENTER" spacing="15" prefWidth="375" prefHeight="667" stylesheets="@styles.css">
    <children>
        <Label text="Sign Up" styleClass="title" />

        <Label text="Your email or username was not unique. Please try again." />

        <VBox spacing="0">
            <Label text="First Name" styleClass="subheading" />
            <TextField fx:id="firstNameField" promptText="Enter your first name" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="0">
            <Label text="Last Name" styleClass="subheading" />
            <TextField fx:id="lastNameField" promptText="Enter your last name" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="0">
            <Label text="Email" styleClass="subheading" />
            <TextField fx:id="emailField" promptText="Enter your email" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="0">
            <Label text="Date of Birth" styleClass="subheading" />
            <TextField fx:id="dobField" promptText="Enter your date of birth" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="0">
            <Label text="Username" styleClass="subheading" />
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="0">
            <Label text="Password" styleClass="subheading" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="password-field" />
        </VBox>
        
        <Button text="Submit" onAction="#submitSignUp" styleClass="button" />
        <Button text="Back to Start" onAction="#switchToStart" styleClass="button" />
    </children>
</VBox>