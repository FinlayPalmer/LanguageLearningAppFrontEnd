<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="667" prefWidth="375" spacing="20" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <children>
        <Label styleClass="title" text="Login" />

              <VBox spacing="5">
            <Label styleClass="subheading" text="Username" />
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="text-field" />
        </VBox>

              <VBox spacing="5">
            <Label styleClass="subheading" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="password-field" />
        </VBox>

              <Button onAction="#switchToSection" styleClass="button" text="Submit" />
        <Button onAction="#switchToStart" styleClass="button" text="Back to Start" />
    </children>
   <padding>
      <Insets left="25.0" right="25.0" />
   </padding>
</VBox>
