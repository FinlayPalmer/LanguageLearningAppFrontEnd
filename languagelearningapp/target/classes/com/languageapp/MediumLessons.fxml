<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" spacing="20" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.MediumLessonsController">
    <children>
        <Label styleClass="title" text="Medium Lessons" />

        <Pane>
            <children>
                <Circle fx:id="lesson1Circle" layoutX="67.0" layoutY="54.0" onMouseClicked="#handleSchoolLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="49.0" layoutY="46.0" styleClass="circle-label" text="School" />

                <Circle fx:id="lesson2Circle" layoutX="221.0" layoutY="99.0" onMouseClicked="#handleMuseumLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="194.0" layoutY="91.0" styleClass="circle-label" text="Museum" />

                <Circle fx:id="lesson3Circle" layoutX="84.0" layoutY="189.0" onMouseClicked="#handleAirportLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="66.0" layoutY="181.0" styleClass="circle-label" text="Airport" />

                <Circle fx:id="lesson4Circle" layoutX="204.0" layoutY="247.0" onMouseClicked="#handleLockedLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="221.0" layoutY="198.0" styleClass="circle-label" text="2/3" />
            </children>
        </Pane>

     <HBox fx:id="navigationBar" styleClass="navigation-bar">
            <Button onAction="#switchToSection" styleClass="nav-button" text="Home" />
            <Button onAction="#goToCompletedLessons" styleClass="nav-button" text="Completed" />
            <Button onAction="#goToProfile" styleClass="nav-button" text="Profile" />
        </HBox>
    </children>
</VBox>
