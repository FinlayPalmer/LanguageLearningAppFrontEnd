<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LeaderboardController">
   <children>
      <Label styleClass="title" text="Leaderboard" />
      <TableView fx:id="leaderboardTable" styleClass="table">
         <columns>
            <TableColumn fx:id="rankColumn" text="Rank" />
            <TableColumn fx:id="usernameColumn" text="Username" />
            <TableColumn fx:id="lessonsColumn" text="Lessons" />
         </columns>
      </TableView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToCurrentLesson" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/lesson.jpg" />
         </image>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToSection" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/home.jpg" />
         </image>
         <VBox.margin>
            <Insets right="200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToProfile" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/profile.jpg" />
         </image>
         <VBox.margin>
            <Insets right="-200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
