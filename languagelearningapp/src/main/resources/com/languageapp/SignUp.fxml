<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="667" prefWidth="375" spacing="15" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SignUpController">
    <children>
        <Label styleClass="title" text="Sign Up" />
      <Label fx:id="errorMessage" styleClass="errorMessage" textAlignment="CENTER" wrapText="true" />

        <VBox spacing="5">
            <Label styleClass="subheading" text="First Name" />
            <TextField fx:id="firstNameField" promptText="Enter your first name" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="5">
            <Label styleClass="subheading" text="Last Name" />
            <TextField fx:id="lastNameField" promptText="Enter your last name" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="5">
            <Label styleClass="subheading" text="Email" />
            <TextField fx:id="emailField" promptText="Enter your email" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="5">
            <Label styleClass="subheading" text="Date of Birth" />
            <TextField fx:id="dobField" promptText="Enter your date of birth" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="5">
            <Label styleClass="subheading" text="Username" />
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="text-field" />
        </VBox>
        
        <VBox spacing="5">
            <Label styleClass="subheading" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="password-field" />
        </VBox>
        
        <Button onAction="#submitSignUp" styleClass="button" text="Submit" />
        <Button onAction="#switchToStart" styleClass="button" text="Back to Start" />
    </children>
   <padding>
      <Insets left="25.0" right="25.0" />
   </padding>
</VBox>
