<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="667" prefWidth="375" spacing="20" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.ResetPasswordController">
    <children>
        <Label text="Reset Password" styleClass="title" />

        <VBox spacing="5">
            <Label styleClass="subheading" text="Old Password" />
            <TextField fx:id="oldPasswordField" promptText="Enter your old password" styleClass="password-field" />
        </VBox>

        <VBox spacing="5">
            <Label styleClass="subheading" text="New Password" />
            <PasswordField fx:id="newPasswordField" promptText="Enter your new password" styleClass="password-field" />
        </VBox>

        <VBox spacing="5">
            <Label styleClass="subheading" text="Confirm New Password" />
            <PasswordField fx:id="confirmNewPasswordField" promptText="Confirm your new password" styleClass="password-field" />
        </VBox>

        <Button onAction="#switchToProfile" styleClass="button" text="Submit" />
        <Button onAction="#switchToProfile" styleClass="button" text="Cancel" />
    </children>
   <padding>
      <Insets left="25.0" right="25.0" />
   </padding>
</VBox>
