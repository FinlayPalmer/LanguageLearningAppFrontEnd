<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LessonController">
   <children>
      <Label fx:id="lessonName" styleClass="title" />
      <Button onMouseClicked="#switchToFlashcard" styleClass="button" text="Flashcard screen" />

      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToLesson" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/lesson.jpg" />
         </image>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToEasy" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/home.jpg" />
         </image>
         <VBox.margin>
            <Insets right="200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToProfile" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/profile.jpg" />
         </image>
         <VBox.margin>
            <Insets right="-200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>

   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
