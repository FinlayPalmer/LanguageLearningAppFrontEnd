<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" prefHeight="428.0" prefWidth="270.0" spacing="20" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.EasyLessonsController">
    <children>
        <Label styleClass="title" text="Easy Lessons" />

        <Pane prefHeight="295.0" prefWidth="270.0">
            <children>
                <Circle fx:id="lesson1Circle" layoutX="67.0" layoutY="54.0" onMouseClicked="#handleColorLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="49.0" layoutY="46.0" styleClass="circle-label" text="Colors" />

                <Circle fx:id="lesson2Circle" layoutX="221.0" layoutY="99.0" onMouseClicked="#handleGreetingLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="194.0" layoutY="91.0" styleClass="circle-label" text="Greetings" />

                <Circle fx:id="lesson3Circle" layoutX="84.0" layoutY="189.0" onMouseClicked="#handleFamilyLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="66.0" layoutY="181.0" styleClass="circle-label" text="Family" />

                <Circle fx:id="lesson4Circle" layoutX="204.0" layoutY="247.0" onMouseClicked="#handleLockedLesson" radius="48.0" styleClass="circle" />
                <Label layoutX="221.0" layoutY="198.0" styleClass="circle-label" text="2/3" />
            </children>
        </Pane>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToCurrentLesson" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/lesson.jpg" />
         </image>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToSection" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/home.jpg" />
         </image>
         <VBox.margin>
            <Insets right="200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
      <ImageView fitHeight="65.0" fitWidth="65.0" onMouseClicked="#switchToProfile" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/profile.jpg" />
         </image>
         <VBox.margin>
            <Insets right="-200.0" top="-85.0" />
         </VBox.margin>
      </ImageView>
    </children>
</VBox>
