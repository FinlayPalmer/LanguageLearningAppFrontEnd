<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="667" prefWidth="375" spacing="20" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.StartScreenController">
    <children>
        <Label styleClass="title" text="Hola!">
         </Label>
        <Button onAction="#loginClicked" styleClass="button" text="Login" />
        <Button onAction="#signUpClicked" styleClass="button" text="Sign Up" />
      <ImageView fitHeight="310.0" fitWidth="392.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/flags.png" />
         </image>
      </ImageView>
    </children>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
