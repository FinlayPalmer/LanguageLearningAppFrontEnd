<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SectionController">
   <children>
      <Label styleClass="title" text="Available Sections" />
      <ImageView fitHeight="86.0" fitWidth="95.0" onMouseClicked="#switchToLeaderboard" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/leaderboard.jpg" />
         </image>
      </ImageView>
      <Button fx:id="easy" onAction="#switchToEasy" text="Easy" />
      <Button fx:id="medium" onAction="#switchToMedium" text="Medium" />
      <Button fx:id="difficult" onAction="#switchToDifficult" text="Difficult" />
      <HBox styleClass="navigation-bar">
         <children>
            <Button mnemonicParsing="false" text="Home" />
            <Button mnemonicParsing="false" onAction="#switchToCurrentLesson" text="Lesson" />
            <Button mnemonicParsing="false" onAction="#switchToProfile" text="Profile" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
